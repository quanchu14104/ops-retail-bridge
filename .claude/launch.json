{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ops-chest-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "ops_chest/backend", "uvicorn", "app.api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "env": {
        "DATABASE_URL": "sqlite:///ops_chest.db",
        "CATALOG_OVERRIDES_PATH": "../../out/ops_catalog_overrides.json",
        "STORE_NAME": "Thanh Lam Mart",
        "STORE_ADDRESS": "12 Phố Demo, Q. Hoàn Kiếm, Hà Nội (giả định)",
        "STORE_PHONE": "024 0000 0000",
        "SMTP_FROM": "cuahang-demo@thanhlammart-demo.test",
        "SMTP_HOST": "localhost",
        "SMTP_PORT": "1025",
        "ENABLE_SCHEDULER": "false",
        "CORS_ORIGINS": "http://localhost:5173",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "ops-chest-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ops_chest/frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "env": {
        "API_TARGET": "http://localhost:8000"
      }
    },
    {
      "name": "retail-ai-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "Retail-AI-", "uvicorn", "backend.api.main:app", "--host", "127.0.0.1", "--port", "8020"],
      "port": 8020,
      "env": {
        "CATALOG_REPOSITORY": "snapshot",
        "OPS_FEED_PATH": "../out/ops_feed.json",
        "CORS_ORIGINS": "http://127.0.0.1:5190,http://localhost:5190",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "retail-kiosk",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Retail-AI-/apps/kiosk-airi", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5190", "--strictPort"],
      "port": 5190,
      "env": {
        "VITE_API_BASE_URL": "http://127.0.0.1:8020"
      }
    }
  ]
}
