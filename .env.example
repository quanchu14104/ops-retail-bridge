# Sao chép thành .env rồi sửa nếu cần. File .env không commit.

# ---- Ops Chest (nguồn dữ liệu vận hành, chỉ đọc) ----
OPS_CHEST_URL=http://127.0.0.1:8000
# Tài khoản nhân viên CHỈ XEM do seed của Ops Chest tạo (đã công khai trong ops_chest/.env.example)
OPS_CHEST_USER=nhanvien
OPS_CHEST_PASSWORD=nhanvien123

# ---- Retail-AI ----
# Postgres của Retail-AI (docker compose up -d postgres). Bridge ghi các bảng feed có sẵn.
RETAIL_DATABASE_URL=postgresql://retail:retail@localhost:5432/retail
# Catalog Thanh Lam Mart (chỉ đọc) và dữ liệu FRN của Ops Chest (chỉ đọc), dùng cho crosswalk
THANH_LAM_CATALOG_PATH=Q:/WORKSPACE/Retail-AI-/data/thanh_lam_products.json
FRN_DATA_PATH=Q:/WORKSPACE/ops_chest/backend/app/sim/data/frn/stores_daily.csv.gz
FRN_STORE_ID=18

# ---- Cửa hàng demo (giả định) ----
STORE_CODE=TLM-DEMO-01
# Mặc định kiosk của Retail-AI (backend/api/schemas.py)
KIOSK_ID=kiosk-01
STORE_ADDRESS=12 Phố Demo, Q. Hoàn Kiếm, Hà Nội (giả định)
STORE_PHONE=024 0000 0000

# ---- Đầu ra ----
OPS_FEED_PATH=out/ops_feed.json
OVERRIDES_PATH=out/ops_catalog_overrides.json
CROSSWALK_PATH=data/crosswalk.csv
TIMEZONE=Asia/Ho_Chi_Minh
