# Biến môi trường cho Ops Chest (repo ops_chest, nhánh main) trong demo nối với Retail-AI.
# File này nằm NGOÀI repo Ops Chest và KHÔNG chứa key LLM. Khoá LLM (nếu cần chat) đặt ở ops_chest/.env;
# biến môi trường của tiến trình được ưu tiên hơn .env, nên các giá trị dưới đây thắng.
# Đường dẫn tương đối tính từ ops_chest/backend (thư mục chạy API và seed).
# Dùng: scripts/setup.ps1 và scripts/start-demo.ps1 tự nạp file này; launch.json (demo/launch.json) có cùng giá trị.
DATABASE_URL=sqlite:///ops_chest.db
CATALOG_OVERRIDES_PATH=../../bridge/out/ops_catalog_overrides.json
STORE_NAME="WinMart+ Demo (giả định)"
STORE_ADDRESS="12 Phố Demo, Q. Hoàn Kiếm, Hà Nội (giả định)"
STORE_PHONE="024 0000 0000"
SMTP_FROM=cuahang-demo@winmart-demo.test
SMTP_HOST=localhost
SMTP_PORT=1025
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:5173
PYTHONIOENCODING=utf-8
