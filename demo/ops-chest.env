# Biến môi trường cho Ops Chest (doanbackup, nhánh main) trong demo nối với Retail-AI.
# File này nằm NGOÀI repo Ops Chest và KHÔNG chứa key LLM. Khoá LLM (nếu cần chat) lấy từ doanbackup/.env;
# biến môi trường của tiến trình được ưu tiên hơn .env, nên các giá trị dưới đây thắng.
# Dùng: set -a; . Q:/WORKSPACE/bridge/demo/ops-chest.env; set +a   (bash)  — hoặc xem Q:/WORKSPACE/.claude/launch.json
DATABASE_URL=sqlite:///Q:/WORKSPACE/doanbackup/backend/ops_chest.db
CATALOG_OVERRIDES_PATH=Q:/WORKSPACE/bridge/out/ops_catalog_overrides.json
STORE_NAME="Thanh Lam Mart"
STORE_ADDRESS="12 Phố Demo, Q. Hoàn Kiếm, Hà Nội (giả định)"
STORE_PHONE="024 0000 0000"
SMTP_FROM=cuahang-demo@Thanh Lam Mart-demo.test
SMTP_HOST=localhost
SMTP_PORT=1025
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:5173
PYTHONIOENCODING=utf-8
