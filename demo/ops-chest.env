# Biến môi trường cho Ops Chest (thư mục ops_chest/) khi chạy đồng bộ với Retail-AI.
# File này nằm NGOÀI thư mục ops_chest/ và KHÔNG chứa key LLM. Khoá LLM (nếu cần chat) đặt ở ops_chest/.env;
# biến môi trường của tiến trình được ưu tiên hơn .env, nên các giá trị dưới đây thắng.
# Đường dẫn tương đối tính từ ops_chest/backend (thư mục chạy API và seed).
# Dùng: scripts/setup.ps1 và scripts/start-demo.ps1 tự nạp file này; launch.json (.claude/launch.json) có cùng giá trị.
DATABASE_URL=sqlite:///ops_chest.db
CATALOG_OVERRIDES_PATH=../../out/ops_catalog_overrides.json
STORE_NAME="Thanh Lam Mart"
STORE_ADDRESS="Thanh Lam Mart — Cửa hàng chính"
STORE_PHONE="024 0000 0000"
SMTP_FROM=cuahang@thanhlammart.local
SMTP_HOST=localhost
SMTP_PORT=1025
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:5173
PYTHONIOENCODING=utf-8
